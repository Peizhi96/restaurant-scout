POSTGRES_DB=restaurant_scout
POSTGRES_USER=restaurant_scout
POSTGRES_PASSWORD=restaurant_scout_dev
DATABASE_URL=postgresql+psycopg://restaurant_scout:restaurant_scout_dev@db:5432/restaurant_scout
APP_ENV=development
LOG_LEVEL=INFO
DEDUP_AUTO_MATCH_THRESHOLD=0.90
DEDUP_REVIEW_THRESHOLD=0.72
INTERNAL_API_KEY=change-this-before-non-local-use
RESTAURANT_REALTY_ENABLED=false
RESTAURANT_REALTY_SITE_URL=https://restaurantrealty.com
RESTAURANT_REALTY_API_URL=https://api.restaurantrealty.verticacrm.com/api/bbcrmapi
RESTAURANT_REALTY_TIMEOUT_SECONDS=20
RESTAURANT_REALTY_REQUEST_DELAY_SECONDS=0.5
RESTAURANT_REALTY_USER_AGENT=RestaurantScout/0.1 (+contact-email)
RESTAURANT_REALTY_TARGET_CITIES=San Mateo,San Carlos,Redwood City,Palo Alto,Mountain View,Sunnyvale
RESTAURANT_REALTY_TARGET_COUNTIES=San Mateo County,Santa Clara County
REMOVAL_MISSING_SCAN_THRESHOLD=2
SCHEDULER_INTERVAL_SECONDS=86400
SCHEDULER_INITIAL_DELAY_SECONDS=60
